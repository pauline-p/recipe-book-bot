BOT_TOKEN=токен от BotFather
WEBAPP_URL=https://адрес-твоего-приложения
DATA_DIR=/data
AI_PROVIDER=gemini
GEMINI_API_KEY=ключ из Google AI Studio
ALLOWED_USER_IDS=твой id в Телеграме
# Сколько раз в день приглашённый друг может просить ИИ разобрать рецепт (0 = без лимита)
AI_DAILY_LIMIT=20
# Наклейки-иллюстрации блюд (рисует Gemini, нужен ключ с оплатой). off — не рисовать
ILLUSTRATIONS=on
